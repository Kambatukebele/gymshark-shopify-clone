{% doc %}
  Renders the icon arrow down.

  @param size - {string} the size of the icon
  @param color - {string} the color of icon

  @example {% render 'icon-chevron-right', size: "", color: "" %}
{% enddoc %}

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  stroke-width="2.5"
  stroke="{{ color | default: "#CACBD2" }}"
  fill="none"
  class="duration-300 transform transition-all"
  style="width: {{- size -}}px; height: {{- size -}}px;"
>
