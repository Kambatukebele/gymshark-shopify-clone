<section
  style="background-color: {{ section.settings.announcement_bg }}; color: {{ section.settings.announcement_text }}"
  id="announcement-{{ section.id }}"
  class="w-full overflow-hidden"
  second-animation="{{ section.settings.announcement_animation | times: 1000 }}"
>
  <div
    id="message-container"
    class="container mx-auto flex flex-col justify-center items-center relative {{ section.settings.announcement_height }}"
  >
    {%- if section.blocks.size != 0 -%}
      {%- for announce in section.blocks -%}
        {%- case announce.type -%}
          {%- when 'announcement-text' -%}
            <p
              class="absolute opacity-0 translate-y-6 transition-all duration-700 text-xs hover:underline"
              {{ announce.shopify_attributes }}
            >
              <a href="{{ announce.settings.announcement_url }}">
                {{ announce.settings.announcement_text }}
              </a>
            </p>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
      {%- for item in (1..3) -%}
        <p class="absolute opacity-0 translate-y-6 transition-all duration-700 text-xs hover:underline">
          <a href="#">Free standard shipping</a>
        </p>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Announcement",
  "class": "announcement",
  "disabled_on": {
    "groups": ["footer"],
    "templates": ["*"]
  },
  "limit": 1,
  "tag": "section",
  "blocks": [
    {
      "name": "Announcement text",
      "type": "announcement-text",
      "limit": 3,
      "settings": [
        {
          "type": "header",
          "content": "Text announcement and URL"
        },
        {
          "type": "text",
          "id": "announcement_text",
          "label": "Announcement text",
          "placeholder": "Enter your announcement",
          "default": "Free delivery"
        },
        {
          "type": "url",
          "id": "announcement_url",
          "label": "Announcement URL"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background color"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background color",
      "default": "#fff",
      "info": "Background color"
    },
    {
      "type": "color",
      "id": "announcement_text",
      "label": "Text color",
      "default": "#000",
      "info": "Text color"
    },
    {
      "type": "select",
      "id": "announcement_height",
      "label": "Annoucement Height",
      "options": [
        {
          "label": "40px",
          "value": "h-10"
        },
        {
          "label": "44px",
          "value": "h-11"
        },
        {
          "label": "48px",
          "value": "h-12"
        }
      ],
      "default": "h-10"
    },
    {
      "type": "range",
      "id": "announcement_animation",
      "label": "Animation",
      "min": 5,
      "max": 10,
      "unit": "s",
      "step": 1,
      "default": 5,
      "info": "Set your animation time"
    }
  ],
  "presets": [
    {
      "name": "Announcement",
      "settings": {
        "announcement_bg": "#fff",
        "announcement_text": "#000",
        "announcement_height": "h-10",
        "announcement_animation": 5
      },
      "blocks": []
    }
  ]
}
{% endschema %}
