  <header
    class="w-full h-[76px] flex justify-center items-center border border-gray-100"
  >
    <div class="container mx-auto px-4">
      <div class="w-full flex justify-between items-center">
        <div class="w-1/3">
          <!-- Menu on mobile -->
          <div class="w-20 flex justify-between items-center lg:hidden">
            <!-- Hamburger Menu -->
            <span id="hamburger-menu" class="block">
              {% render 'icon-hamburger', size: '28', color: '#1b1b1b' %}
            </span>
            <!-- Search icon -->
            <!-- Search icon -->
            <button class="block">
              {% render 'icon-search', size: '20', color: '#1b1b1b' %}
              <span class="hidden">What are you looking for today...</span>
            </button>
          </div>
          <!-- Navigation -->
          <ul class="hidden lg:flex justify-start gap-6 text-sm">
            <!-- Link card -->
            <li class="nav-desktop"><a href="#">Women</a></li>
            <!-- Link card -->
            <li class="nav-desktop"><a href="#">Men</a></li>
            <!-- Link card -->
            <li class="nav-desktop"><a href="#">Accessories</a></li>
          </ul>
        </div>
        <!-- Logo -->
        <a href="{{ shop.url }}" class="w-1/3 flex justify-center items-center">
          {%- if settings.logo != blank -%}
            {{- settings.logo | image_url: width: settings.logo_width | image_tag -}}
          {%- else -%}
            <span class="text-sm font-bold"> {{ shop.name | upcase }} </span>
          {%- endif -%}
        </a>
        <!-- Search, icons -->
        <div class="w-1/3 flex justify-end xl:">
          <div class="flex justify-end items-center gap-4 xl:gap-6">
            <!-- Search icon -->
            <button
              class="hidden lg:flex justify-center items-center cursor-pointer rounded-[40px] py-3 px-4 bg-[#F5F5F5] gap-2"
            >
              <span class="block">{% render 'icon-search', size: '20', color: '#1b1b1b' %}</span>
              <span class="hidden 2xl:block text-sm text-[#6e6e6e]">What are you looking for today...</span>
            </button>
            <!-- icons -->
            <div
              class="flex justify-between items-center w-16 lg:w-fit lg:gap-4 xl:gap-6"
            >
              <!-- heart icon -->
              <span class="hidden lg:block cursor-pointer">
                {%- render 'icon-heart', size: '20', color: '#1b1b1b' -%}
              </span>
              <!-- user icon -->
              <span class="cursor-pointer">
                {% render 'icon-user', size: '20', color: '#1b1b1b' %}
              </span>
              <!-- cart icon -->
              <span class="cursor-pointer">
                {% render 'icon-cart', size: '20', color: '#1b1b1b' %}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
