  "name": "Header",
  "class": "header",
  "disabled_on": {
    "groups": ["footer"],
    "templates": ["*"]
  },
  "limit": 1,
  "tag": "header",
  "settings": [],
  "presets": [
    {
      "name": "Header",
      "settings": {},
      "blocks": []
    }
  ]
}
{% endschema %}
