<section
  id="header"
  class="w-full relative"
>
  <header
    class="w-full h-[76px] flex justify-center items-center border border-gray-100"
  >
    <div class="container mx-auto px-4">
      <div class="w-full flex justify-between items-center">
        <div class="w-1/3">
          <!-- Menu on mobile -->
          <div class="w-20 flex justify-between items-center lg:hidden">
            <!-- Hamburger Menu -->
            <span id="hamburger-menu" class="block">
              {% render 'icon-hamburger', size: '28', color: '#1b1b1b' %}
            </span>
            <!-- Search icon -->
            <!-- Search icon -->
            <button class="block">
              {% render 'icon-search', size: '20', color: '#1b1b1b' %}
              <span class="hidden">What are you looking for today...</span>
            </button>
          </div>
          <!-- Navigation Desktop -->
          <ul class="hidden lg:flex justify-start gap-6 text-sm">
            {% for nav_link in section.settings.header_navigation.links %}
              {%- assign link_handle = nav_link.title | handle -%}
              <li
                class="nav-desktop main-menu-tab"
                data-target-id="content-{{ link_handle }}"
              >
                <a href="#">{{ nav_link.title }}</a>
              </li>
            {%- else -%}
              {% comment %}
                <!-- Link card -->
                <li class="nav-desktop main-menu-tab" data-target-id="content-women"><a href="#">Women</a></li>
                <!-- Link card -->
                <li class="nav-desktop main-menu-tab" data-target-id="content-men"><a href="#">Men</a></li>
                <!-- Link card -->
                <li class="nav-desktop main-menu-tab" data-target-id="content-accessories">
                  <a href="#">Accessories</a>
                </li>
              {% endcomment %}
            {% endfor %}
          </ul>
        </div>
        <!-- Logo -->
        <a href="{{ shop.url }}" class="w-1/3 flex justify-center items-center">
          {%- if settings.logo != blank -%}
            {{- settings.logo | image_url: width: settings.logo_width | image_tag -}}
          {%- else -%}
            <span class="text-sm font-bold"> {{ shop.name | upcase }} </span>
          {%- endif -%}
        </a>
        <!-- Search, icons -->
        <div class="w-1/3 flex justify-end">
          <div class="flex justify-end items-center gap-4 xl:gap-6">
            <!-- Search icon -->
            <button
              class="hidden lg:flex justify-center items-center cursor-pointer rounded-[40px] py-3 px-4 bg-[#F5F5F5] gap-2"
            >
              <span class="block">{% render 'icon-search', size: '20', color: '#1b1b1b' %}</span>
              <span class="hidden 2xl:block text-sm text-[#6e6e6e]">What are you looking for today...</span>
            </button>
            <!-- icons -->
            <div
              class="flex justify-between items-center w-16 lg:w-fit lg:gap-4 xl:gap-6"
            >
              <!-- heart icon -->
              <span class="hidden lg:block cursor-pointer">
                {%- render 'icon-heart', size: '20', color: '#1b1b1b' -%}
              </span>
              <!-- user icon -->
              <span class="cursor-pointer">
                {% render 'icon-user', size: '20', color: '#1b1b1b' %}
              </span>
              <!-- cart icon -->
              <span class="cursor-pointer">
                {% render 'icon-cart', size: '20', color: '#1b1b1b' %}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
  <!-- Mega menu section -->
  <div
    id="mega-menu"
    class="w-full bg-white h-screen z-10 fixed top-0 left-0 translate-x-full overflow-y-auto duration-700 ease-in-out lg:h-fit lg:top-28 lg:translate-x-0 lg:translate-y-20 lg:opacity-0 lg:pointer-events-none "
  >
    <div
      class="container mx-auto px-4 py-8 w-full flex flex-col items-center justify-center gap-8 lg:py-16"
    >
      <!-- upper menu -->
      <div
        class="w-full flex flex-col items-center justify-center gap-8 lg:hidden"
      >
        <div class="w-full flex justify-between items-center">
          <!-- Close Menu -->
          <span id="close-menu" class="block">
            {% render 'icon-close', size: '20', color: '#000' %}
          </span>
          <!-- heart icon -->
          <span class="block">
            {% render 'icon-heart', size: '20', color: '#1b1b1b' %}
          </span>
        </div>
        <!-- Search icon -->
        <!-- Search icon -->
        {% render 'search-block',
          classes: 'w-full flex justify-start
        items-center cursor-pointer rounded-[40px] py-4 px-4 bg-[#F5F5F5]
        gap-2',
          classesText: 'block text-sm text-[#6e6e6e]'
        %}
      </div>
      <!-- Menu mobile -->
      <ul
        class="w-full flex justify-start items-center gap-4 text-sm lg:hidden"
      >
        {%- for navSmall in section.settings.header_navigation.links -%}
          {%- assign link_handle = navSmall.title | handle -%}
          <li
            data-target-id="content-{{ link_handle }}"
            class="
              mobile-menu-tab py-2 cursor-pointer
              {% if forloop.first %}border-b font-bold{% endif %}
            "
          >
            {{ navSmall.title -}}
          </li>
        {%- else -%}
          <li
            data-target-id="content-women"
            class="mobile-menu-tab border-b py-2 font-bold cursor-pointer"
          >
            Women
          </li>
          <li data-target-id="content-men" class="mobile-menu-tab border-b py-2 font-bold cursor-pointer">Men</li>
          <li
            data-target-id="content-accessories"
            class="mobile-menu-tab border-b py-2 font-bold cursor-pointer"
          >
            Accessories
          </li>
        {%- endfor -%}
      </ul>
      <!-- SubMenu -->
      <div
        class="w-full flex flex-col-reverse items-center justify-center gap-8 xl:flex-row xl:items-stretch"
      >
        <!-- menu text left lg:grid lg:grid-cols-5 lg:gap-2 lg:row-span-2 -->
        <div
          class="w-full flex flex-col gap-4 xl:w-2/3"
        >
          {% for nav_link in section.settings.header_navigation.links %}
            {% assign link_handle = nav_link.title | handle %}
            {% assign sub_menu = linklists[nav_link.handle] %}
            <div
              id="content-{{ link_handle }}"
              class="mega-menu-content-panel w-full flex flex-col justify-center items-start gap-4 lg:flex-row {% if forloop.first %}{% else %}hidden{% endif %}"
            >
              {%- if sub_menu.links.size > 0 -%}
                {% for sub_link in sub_menu.links %}
                  <div
                    class="w-full flex flex-col justify-center items-start gap-4"
                  >
                    <div class="subHeadings w-full flex justify-between items-center">
                      <h6
                        class="text-sm text-black font-bold lg:uppercase lg:text-[#666666]"
                      >
                        {{ sub_link.title }}
                      </h6>
                      <span class="subHeadingsIcons block lg:hidden">
                        {%- render 'icon-arrow-down', size: '12', color: '#1b1b1b' -%}
                      </span>
                    </div>

                    {% comment %} Sub-heading links (third level) {% endcomment %}
                    <div
                      class="subHeadingsBodys hidden flex-col text-[#6e6e6e] gap-2 text-sm lg:flex"
                    >
                      {%- for body in sub_link.links -%}
                        <a href="{{ body.url }}">{{ body.title }}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                <p class="text-[#6e6e6e] text-sm">No sub-menu items found for {{ nav_link.title }}.</p>
              {%- endif -%}
            </div>
          {% endfor %}
        </div>
        <!-- menu images right -->
        <div
          id="mega-menu-images"
          class="w-full xl:w-1/3 xl:flex xl:flex-col xl:justify-start xl:items-start xl:gap-4"
        >
          {% for nav_link in section.settings.header_navigation.links %}
            {% assign link_handle = nav_link.title | handle %}
            {%- comment -%} Check if the nav_link URL contains '/collections/' {%- endcomment -%}
            {% if nav_link.url contains '/collections/' %}
              {%- comment -%} Extract collection handle from URL {%- endcomment -%}
              {% assign collection_handle = nav_link.url | split: '/collections/' | last | split: '/' | first %}
              {% assign collection = collections[collection_handle] %}
              <div
                id="images-{{ link_handle }}"
                class="mega-menu-images-panel hidden w-full"
              >
                <div class="hidden xl:block w-full">
                  <h6
                    class="text-sm text-black font-bold lg:uppercase lg:text-[#666666]"
                  >
                    Featured
                  </h6>
                </div>
                <div
                  class="w-full snap-x snap-mandatory flex overflow-scroll justify-start items-center gap-2 xl:snap-none xl:overflow-hidden xl:flex-col xl:items-start"
                >
                  {%- if collection != blank and collection.products.size > 0 -%}
                    {%- for product in collection.products limit: 2 -%}
                      <!-- image menu card with real product -->
                      <div class="border border-[#6e6e6e61] rounded w-[288px] h-[180px] sm:w-[608px] sm:h-[380px] md:w-[758px] md:h-[473px] xl:w-[388px] xl:h-[220px] relative snap-start grow">
                        <a href="{{ product.url }}" class="block w-full h-full">
                          <div class="w-[288px] h-[180px] rounded sm:w-[608px] sm:h-[380px] md:w-[758px] md:h-[473px] xl:w-[388px] xl:h-[220px]">
                            {%- if product.featured_image != blank -%}
                              <img
                                src="{{ product.featured_image | image_url: width: 800 }}"
                                alt="{{ product.title | escape }}"
                                class="w-full rounded h-full object-center object-cover"
                                loading="lazy"
                              >
                            {%- else -%}
                              {{
                                'product-1'
                                | placeholder_svg_tag: 'w-full rounded h-full object-center object-cover overflow-hidden'
                              }}
                            {%- endif -%}
                          </div>
                          <span class="uppercase absolute bottom-2 left-2 text-xs sm:text-sm bg-white/80 px-2 py-1 rounded">
                            {{ product.title | truncate: 20 }}
                          </span>
                        </a>
                      </div>
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment -%} Fallback if collection has no products {%- endcomment -%}
                    {%- for item in (1..2) -%}
                      <!-- image menu card -->
                      <div
                        class="border border-[#6e6e6e61] rounded w-[288px] h-[180px] sm:w-[608px] sm:h-[380px] md:w-[758px] md:h-[473px] xl:w-[388px] xl:h-[220px] relative snap-start grow"
                      >
                        <div
                          class="w-[288px] h-[180px] rounded sm:w-[608px] sm:h-[380px] md:w-[758px] md:h-[473px] xl:w-[388px] xl:h-[220px]"
                        >
                          {{
                            'product-1'
                            | placeholder_svg_tag: 'w-full rounded h-full object-center object-cover overflow-hidden'
                          }}
                        </div>
                        <span
                          class="uppercase absolute bottom-2 left-2 text-xs sm:text-sm"
                          >Cosy luxe</span
                        >
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% javascript %}
  // --- Global Constants ---
  const MEGA_MENU = document.querySelector('#mega-menu');
  // Mobile Menu Toggles
  const HAMBURGER_MENU = document.querySelector('#hamburger-menu');
  const CLOSE_MENU = document.querySelector('#close-menu');

  // Mobile/Desktop Elements for Tab Switching
  const NAV_DESKTOP = document.querySelectorAll('.nav-desktop');
  const MOBILE_MENU_TABS = document.querySelectorAll('.mobile-menu-tab');
  const MEGA_MENU_CONTENT_PANELS = document.querySelectorAll('.mega-menu-content-panel');
  const MEGA_MENU_IMAGE_PANEL = document.querySelector('#mega-menu-images');

  // Subheading Accordion Toggles
  const SUB_HEADINGS = document.querySelectorAll('.subHeadings');
  const SUB_HEADINGS_ICONS = document.querySelectorAll('.subHeadingsIcons');
  const SUB_HEADINGS_BODYS = document.querySelectorAll('.subHeadingsBodys');

  // Global variable to manage the closing delay
  let menuCloseTimeout;

  // --- 1. Mobile Menu Open/Close ---
  function showAndHideMenuOnSmallDevice() {
    function toggleMenuOnSmallDevice(menu_icon, mega_menu, class_one, class_two) {
      if (!menu_icon || !mega_menu) return;
      menu_icon.addEventListener('click', () => {
        mega_menu.classList.replace(class_one, class_two);

        // Show images on mobile when menu opens
        if (class_two === 'translate-x-0' && MEGA_MENU_IMAGE_PANEL) {
          MEGA_MENU_IMAGE_PANEL.classList.remove('hidden');
        }
      });
    }
    toggleMenuOnSmallDevice(HAMBURGER_MENU, MEGA_MENU, 'translate-x-full', 'translate-x-0');
    toggleMenuOnSmallDevice(CLOSE_MENU, MEGA_MENU, 'translate-x-0', 'translate-x-full');
  }
  showAndHideMenuOnSmallDevice();

  // --- 2. Mobile Subheading Accordion ---
  function openAndCloseSubHeadings() {
    SUB_HEADINGS.forEach((sub_heading, index) => {
      sub_heading.addEventListener('click', () => {
        if (SUB_HEADINGS_ICONS[index].classList.contains('rotate-180')) {
          SUB_HEADINGS_ICONS[index].classList.remove('rotate-180');
          SUB_HEADINGS_BODYS[index].classList.add('hidden');
          SUB_HEADINGS_BODYS[index].classList.remove('flex');
        } else {
          SUB_HEADINGS_ICONS[index].classList.add('rotate-180');
          SUB_HEADINGS_BODYS[index].classList.remove('hidden');
          SUB_HEADINGS_BODYS[index].classList.add('flex');
        }
      });
    });
  }
  openAndCloseSubHeadings();

  // --- 3. Mobile Tab Switching (Click) - ONLY TOGGLE 'hidden' ---
  function handleMobileMenuContentSwitch() {
    MOBILE_MENU_TABS.forEach((tab) => {
      tab.addEventListener('click', () => {
        // 1. Clear all active states
        MOBILE_MENU_TABS.forEach((t) => t.classList.remove('border-b', 'font-bold'));

        // 2. Hide all content panels using 'hidden'
        MEGA_MENU_CONTENT_PANELS.forEach((panel) => {
          panel.classList.add('hidden');
        });

        // 3. Get the target ID and panel
        const targetId = tab.getAttribute('data-target-id');
        const targetPanel = document.getElementById(targetId);

        // 4. Show the target panel by REMOVING 'hidden'
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
          // Tailwind's responsive classes (flex and lg:grid) handle the correct display style.
        }

        // 5. Apply 'active' styling
        tab.classList.add('border-b', 'font-bold');
      });
    });
  }
  handleMobileMenuContentSwitch();

  // --- 4. Desktop Mega Menu Show/Hide and Content Switching (Hover) ---
  function showOrHideMegaMenuOnLargeDevice() {
    // Show/Hide Menu functions remain the same
    const showMenu = () => {
      clearTimeout(menuCloseTimeout);
      MEGA_MENU.classList.replace('lg:opacity-0', 'lg:opacity-100');
      MEGA_MENU.classList.replace('lg:translate-y-20', 'lg:translate-y-0');
      MEGA_MENU.classList.remove('lg:pointer-events-none');

      // *** FIX: Explicitly SHOW the image panel when the menu opens on XL screens ***
      if (window.innerWidth >= 1280 && MEGA_MENU_IMAGE_PANEL) {
        // 1280px is Tailwind's 'xl' breakpoint
        MEGA_MENU_IMAGE_PANEL.classList.remove('hidden');
      }
    };

    const hideMenu = () => {
      menuCloseTimeout = setTimeout(() => {
        MEGA_MENU.classList.replace('lg:opacity-100', 'lg:opacity-0');
        MEGA_MENU.classList.replace('lg:translate-y-0', 'lg:translate-y-20');
        MEGA_MENU.classList.add('lg:pointer-events-none');

        // *** FIX: Explicitly HIDE the image panel when the menu closes on XL screens ***
        if (window.innerWidth >= 1280 && MEGA_MENU_IMAGE_PANEL) {
          MEGA_MENU_IMAGE_PANEL.classList.add('hidden');
        }
      }, 50);
    };

    NAV_DESKTOP.forEach((nav) => {
      // 1. MOUSEENTER: Opens menu and switches content
      nav.addEventListener('mouseenter', () => {
        showMenu();

        // Content Switching Logic:
        const targetId = nav.getAttribute('data-target-id');

        // Hide all content panels using 'hidden'
        MEGA_MENU_CONTENT_PANELS.forEach((panel) => {
          panel.classList.add('hidden');
        });

        const targetPanel = document.getElementById(targetId);

        // Show the target panel by REMOVING 'hidden'
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });

      // 2. MOUSELEAVE: Starts the close timer (Needed for menu to close properly)
      nav.addEventListener('mouseleave', hideMenu);
    });

    // 3. MEGA_MENU MOUSEENTER: Cancel the close timer
    MEGA_MENU.addEventListener('mouseenter', showMenu);

    // 4. MEGA_MENU MOUSELEAVE: Starts the close timer
    MEGA_MENU.addEventListener('mouseleave', hideMenu);
  }
  showOrHideMegaMenuOnLargeDevice();

  // --- 5. Initialize image panel visibility on load ---
  function initializeImagePanelVisibility() {
    if (!MEGA_MENU_IMAGE_PANEL) return;

    // Hide images on desktop (xl) by default, show on mobile
    if (window.innerWidth >= 1280) {
      MEGA_MENU_IMAGE_PANEL.classList.add('hidden');
    } else {
      MEGA_MENU_IMAGE_PANEL.classList.remove('hidden');
    }
  }
  initializeImagePanelVisibility();

  // Re-initialize on window resize
  window.addEventListener('resize', initializeImagePanelVisibility);
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "class": "header",
  "disabled_on": { "groups": ["footer"], "templates": ["*"] },
  "limit": 1,
  "tag": "header",
  "settings": [
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "header_navigation", "label": "Menu navigation", "default": "main-menu" }
  ],
  "presets": [{ "name": "Header", "settings": { "header_navigation": "main-menu" }, "blocks": [] }]
}
{% endschema %}
