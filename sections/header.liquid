{% comment %}
  <header class="w-full h-[76px] flex justify-center items-center">
    <div class="container mx-auto px-4">
      <div class="w-full flex justify-between items-center">
        <div class="w-1/3">
          <!-- Menu on mobile -->
          <div class="w-20 flex justify-between items-center lg:hidden">
            <!-- Hamburger Menu -->
            <span class="block">
              {% render 'icon-hamburger', size: '28', color: '#1b1b1b' %}
            </span>
            <!-- Search icon -->
            <!-- Search icon -->
            <button class="block">
              {% render 'icon-search', size: '20', color: '#1b1b1b' %}
              <span class="hidden">What are you looking for today...</span>
            </button>
          </div>
          <!-- Navigation -->
          <ul class="hidden lg:flex justify-start gap-6 text-sm">
            <!-- Link card -->
            <li>
              <a href="#">Women</a>
            </li>
            <!-- Link card -->
            <li>
              <a href="#">Men</a>
            </li>
            <!-- Link card -->
            <li>
              <a href="#">Accessories</a>
            </li>
          </ul>
        </div>

        <!-- Logo -->
        <div class="w-1/3 flex justify-center items-center">
          {%- if settings.logo != blank -%}
            {{- settings.logo | image_url: width: settings.logo_width | image_tag -}}
          {%- else -%}
            <span class="text-sm font-bold">
              {{ shop.name | upcase }}
            </span>
          {%- endif -%}
        </div>
        <!-- Search, icons -->
        <div class="w-1/3 flex justify-end xl:">
          <div class="flex justify-end items-center gap-4 xl:gap-6">
            <!-- Search icon -->
            <button class="hidden lg:flex justify-center items-center cursor-pointer rounded-[40px] py-3 px-4 bg-[#F5F5F5] gap-2">
              <span class="block">{% render 'icon-search', size: '20', color: '#1b1b1b' %}</span>
              <span class="hidden 2xl:block text-sm text-[#6e6e6e]">What are you looking for today...</span>
            </button>
            <!-- icons -->
            <div class="flex justify-between items-center w-16 lg:w-fit lg:gap-4 xl:gap-6">
              <!-- heart icon -->
              <span class="hidden lg:block cursor-pointer">{% render 'icon-heart', size: '20', color: '#1b1b1b' %}</span>
              <!-- user icon -->
              <span class="cursor-pointer">
                {% render 'icon-user', size: '20', color: '#1b1b1b' %}
              </span>
              <!-- cart icon -->
              <span class="cursor-pointer">
                {% render 'icon-cart', size: '20', color: '#1b1b1b' %}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
{% endcomment %}

<div class="px-4 py-8 w-full flex flex-col items-center justify-center gap-8">
  <!-- upper menu -->
  <div class="w-full flex flex-col items-center justify-center gap-8 lg:hidden">
    <div class="w-full flex justify-between items-center">
      <!-- Close Menu -->
      <span class="block">
        {% render 'icon-close', size: '20', color: '#000' %}
      </span>
      <!-- heart icon -->
      <span class="block">
        {% render 'icon-heart', size: '20', color: '#1b1b1b' %}
      </span>
    </div>
    <!-- Search icon -->
    <!-- Search icon -->
    {% render 'search-block',
      classes: 'w-full flex justify-start items-center cursor-pointer rounded-[40px] py-4 px-4 bg-[#F5F5F5] gap-2',
      classesText: 'block text-sm text-[#6e6e6e]'
    %}
  </div>
  <!-- Menu -->
  <ul class="w-full flex justify-start items-center gap-4 text-sm lg:hidden">
    <li>Women</li>
    <li>Men</li>
    <li>Accessories</li>
  </ul>
  <!-- SubMenu -->
  <div class="w-full flex flex-col-reverse items-center justify-center gap-8 border xl:flex-row xl:items-start">
    <!-- menu text left -->
    <div class="w-full flex flex-col gap-4 lg:flex-row">
      {%- for item in (1..6) -%}
        <!-- Menu block card -->
        <div class="w-full flex flex-col justify-center items-start gap-4">
          <div class="w-full flex justify-between items-center">
            <h6 class="text-sm text-black lg:uppercase lg:text-[#666666]">Trending</h6>
            <span class="lg:hidden">{% render 'icon-arrow-down', size: '12', color: '#1b1b1b' %}</span>
          </div>
          <div class="flex flex-col text-[#6e6e6e] gap-2 text-sm">
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
            <a href="">Lorem ipsum</a>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <!-- menu images right -->
    <div class="w-full lg:hidden xl:block xl:w-1/3">
      <div class="hidden xl:block">
        <h6 class="text-sm text-black lg:uppercase lg:text-[#666666]">Featured</h6>
      </div>
      <div class="w-full snap-x snap-mandatory flex overflow-scroll justify-start items-center gap-2 xl:snap-none xl:overflow-hidden xl:flex-col">
        {%- for item in (1..2) -%}
          <!-- image menu card -->
          <div class="border border-[#6e6e6e61] rounded w-[288px] h-[180px] sm:w-[608px] sm:h-[380px] md:w-[758px] md:h-[473px] xl:w-[288px] xl:h-[180px] relative snap-start grow">
            <div class="w-[288px] h-[180px] rounded sm:w-[608px] sm:h-[380px] md:w-[758px] md:h-[473px] xl:w-[288px] xl:h-[180px]">
              {{
                'product-1'
                | placeholder_svg_tag: 'w-full rounded h-full object-center object-cover overflow-hidden'
              }}
            </div>
            <span class="uppercase absolute bottom-2 left-2 text-xs sm:text-sm">Cosy luxe</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
